rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.active == true;
    }

    function isValidLead() {
      return request.resource.data.keys().hasOnly([
          'email',
          'fullName',
          'source',
          'interest',
          'company',
          'projectTitle',
          'brief',
          'contextId',
          'inquiryType',
          'inquiryTypeLabel',
          'goal',
          'goalLabel',
          'surface',
          'surfaceLabel',
          'engagement',
          'engagementLabel',
          'timeline',
          'timelineLabel',
          'budgetRange',
          'budgetRangeLabel',
          'createdAt',
          'updatedAt',
          'status',
          'consent'
        ]) &&
        request.resource.data.keys().hasAll([
          'email',
          'fullName',
          'source',
          'interest',
          'createdAt',
          'updatedAt',
          'status',
          'consent'
        ]) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 160 &&
        request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$') &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() <= 80 &&
        request.resource.data.source is string &&
        request.resource.data.source.size() >= 3 &&
        request.resource.data.source.size() <= 120 &&
        request.resource.data.interest is string &&
        request.resource.data.interest.size() >= 3 &&
        request.resource.data.interest.size() <= 160 &&
        (!request.resource.data.keys().hasAny(['company']) ||
          (request.resource.data.company is string && request.resource.data.company.size() <= 160)) &&
        (!request.resource.data.keys().hasAny(['projectTitle']) ||
          (request.resource.data.projectTitle is string && request.resource.data.projectTitle.size() <= 160)) &&
        (!request.resource.data.keys().hasAny(['brief']) ||
          (request.resource.data.brief is string && request.resource.data.brief.size() <= 3000)) &&
        (!request.resource.data.keys().hasAny(['contextId']) ||
          (request.resource.data.contextId is string && request.resource.data.contextId.size() <= 120)) &&
        (!request.resource.data.keys().hasAny(['inquiryType']) ||
          (request.resource.data.inquiryType is string && request.resource.data.inquiryType.size() <= 80)) &&
        (!request.resource.data.keys().hasAny(['inquiryTypeLabel']) ||
          (request.resource.data.inquiryTypeLabel is string && request.resource.data.inquiryTypeLabel.size() <= 120)) &&
        (!request.resource.data.keys().hasAny(['goal']) ||
          (request.resource.data.goal is string && request.resource.data.goal.size() <= 80)) &&
        (!request.resource.data.keys().hasAny(['goalLabel']) ||
          (request.resource.data.goalLabel is string && request.resource.data.goalLabel.size() <= 120)) &&
        (!request.resource.data.keys().hasAny(['surface']) ||
          (request.resource.data.surface is string && request.resource.data.surface.size() <= 80)) &&
        (!request.resource.data.keys().hasAny(['surfaceLabel']) ||
          (request.resource.data.surfaceLabel is string && request.resource.data.surfaceLabel.size() <= 120)) &&
        (!request.resource.data.keys().hasAny(['engagement']) ||
          (request.resource.data.engagement is string && request.resource.data.engagement.size() <= 80)) &&
        (!request.resource.data.keys().hasAny(['engagementLabel']) ||
          (request.resource.data.engagementLabel is string && request.resource.data.engagementLabel.size() <= 120)) &&
        (!request.resource.data.keys().hasAny(['timeline']) ||
          (request.resource.data.timeline is string && request.resource.data.timeline.size() <= 80)) &&
        (!request.resource.data.keys().hasAny(['timelineLabel']) ||
          (request.resource.data.timelineLabel is string && request.resource.data.timelineLabel.size() <= 120)) &&
        (!request.resource.data.keys().hasAny(['budgetRange']) ||
          (request.resource.data.budgetRange is string && request.resource.data.budgetRange.size() <= 80)) &&
        (!request.resource.data.keys().hasAny(['budgetRangeLabel']) ||
          (request.resource.data.budgetRangeLabel is string && request.resource.data.budgetRangeLabel.size() <= 120)) &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() >= 20 &&
        request.resource.data.createdAt.size() <= 40 &&
        request.resource.data.updatedAt is string &&
        request.resource.data.updatedAt.size() >= 20 &&
        request.resource.data.updatedAt.size() <= 40 &&
        request.resource.data.status == 'new' &&
        request.resource.data.consent == true;
    }

    function isValidListeningRoomVisit() {
      return request.resource.data.keys().hasOnly([
          'eventType',
          'songSlug',
          'songTitle',
          'queryKey',
          'pagePath',
          'referrer',
          'userAgent',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'eventType',
          'songSlug',
          'songTitle',
          'queryKey',
          'pagePath',
          'referrer',
          'userAgent',
          'createdAt'
        ]) &&
        request.resource.data.eventType == 'listening-room-link-visit' &&
        request.resource.data.songSlug is string &&
        request.resource.data.songSlug.size() >= 1 &&
        request.resource.data.songSlug.size() <= 80 &&
        request.resource.data.songTitle is string &&
        request.resource.data.songTitle.size() >= 1 &&
        request.resource.data.songTitle.size() <= 120 &&
        request.resource.data.queryKey is string &&
        request.resource.data.queryKey.size() >= 1 &&
        request.resource.data.queryKey.size() <= 24 &&
        request.resource.data.pagePath is string &&
        request.resource.data.pagePath.size() >= 1 &&
        request.resource.data.pagePath.size() <= 240 &&
        request.resource.data.referrer is string &&
        request.resource.data.referrer.size() <= 320 &&
        request.resource.data.userAgent is string &&
        request.resource.data.userAgent.size() <= 320 &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() >= 20 &&
        request.resource.data.createdAt.size() <= 40;
    }

    match /adminUsers/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /adminProjects/{projectId} {
      allow read, write: if isAdmin();

      match /markdownFiles/{fileId} {
        allow read, write: if isAdmin();
      }
    }

    match /adminProjects/walls-devine/publicContent/{docId} {
      allow read: if docId == 'collectorHeroNote' || docId == 'linkHub';
      allow write: if isAdmin();
    }

    match /ecosystemLeads/{leadId} {
      allow read: if isAdmin();
      allow create: if isValidLead();
    }

    match /listeningRoomVisits/{visitId} {
      allow read: if isAdmin();
      allow create: if isValidListeningRoomVisit();
    }
  }
}